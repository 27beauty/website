# Copy to .dev.vars for local development (never commit .dev.vars).
# In production set these with: wrangler secret put <NAME>

# Signs admin session and cart cookies. Generate: openssl rand -hex 32
SESSION_SECRET="dev-secret-change-me-0000000000000000"

# Stripe (test keys locally)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# eBay developer application (https://developer.ebay.com) — production keyset
EBAY_CLIENT_ID="..."
EBAY_CLIENT_SECRET="..."
# Optional: only needed for the Sell APIs (live stock/price on accounts you own).
EBAY_REFRESH_TOKEN=""
EBAY_REFRESH_TOKEN_2=""

# Protects POST /api/sync/ebay when called from outside the admin panel.
SYNC_TOKEN="dev-sync-token"

# Parcel2Go (My Account → API on parcel2go.com) — pushes paid orders across
# so they're ready to book. Client ID may include a ":AppName" suffix as
# issued.
PARCEL2GO_CLIENT_ID="..."
PARCEL2GO_CLIENT_SECRET="..."

# Centralised stock (docs/central-stock.md). eBay "RuName" from the Production
# keyset's User Tokens page — not secret.
EBAY_RUNAME="..."
# Amazon SP-API: app client id/secret, the self-authorised refresh token, and
# the Seller Central Merchant Token.
AMAZON_LWA_CLIENT_ID="..."
AMAZON_LWA_CLIENT_SECRET="..."
AMAZON_REFRESH_TOKEN="..."
AMAZON_SELLER_ID="..."
